{
  "surfaceLayout": {
    "leftWindowGapWidth": 2,
    "leftBorder": "▎",
    "leftBorderWidth": 1,
    "borderContentGapWidth": 0,
    "reset": "\u001b[0m"
  },
  "editor": {
    "height": {
      "min": 4,
      "max": 12,
      "maxRatio": 0.32
    },
    "background": { "rgb": [49, 50, 68] },
    "rail": { "rgb": [137, 180, 250] },
    "selection": {
      "background": { "rgb": [69, 71, 90] },
      "foreground": { "rgb": [245, 245, 250] }
    },
    "pasteMarker": {
      "background": { "rgb": [69, 71, 90] },
      "foreground": "editor.rail",
      "bold": true
    },
    "mouseTracking": {
      "enabled": false
    }
  },
  "conversationScroll": {
    "mode": "app",
    "enabled": true,
    "alternateScreen": true,
    "wheelStepRows": 3,
    "performance": {
      "historyTailRenderWindow": 4
    },
    "scrollbar": {
      "visible": true,
      "dragEnabled": true,
      "trackBackground": "transparent",
      "thumbBackground": { "rgb": [137, 180, 250] },
      "widthMultiplier": 1,
      "dragAnimationMs": 90
    }
  },
  "thinking": {
    "background": "transparent",
    "rail": { "rgb": [203, 166, 247] }
  },
  "assistantReply": {
    "alignSurface": "thinking"
  },
  "userMessage": {
    "background": { "rgb": [49, 50, 68] },
    "rail": { "rgb": [137, 180, 250] },
    "textGapWidth": 1,
    "verticalPaddingRows": 1,
    "timestampColor": { "rgb": [127, 132, 156] }
  },
  "slashCommand": {
    "background": { "rgb": [49, 50, 68] },
    "rail": { "rgb": [148, 226, 213] },
    "selectedText": { "rgb": [137, 180, 250] },
    "textGapWidth": 1,
    "bottomReservedRows": 1,
    "firstLevelHeightMultiplier": 2,
    "nestedMaxOverlayRows": 6,
    "minPrimaryColumnWidth": 12,
    "maxPrimaryColumnWidth": 32
  },
  "bashExecution": {
    "background": { "rgb": [24, 24, 37] },
    "rail": { "rgb": [249, 226, 175] },
    "leftBorder": "▎",
    "borderContentGapWidth": 0,
    "verticalSpacingRows": 1
  },
  "railSections": {
    "defaults": {
      "selectable": true,
      "collapsible": false,
      "clickToToggle": false,
      "preserveScrollOnToggle": true,
      "preserveScrollOnUpdate": true,
      "autoCollapseAfterRows": false,
      "collapsedRenderMode": "review",
      "layout": {
        "leftWindowGapWidth": 2,
        "leftBorder": "▎",
        "leftBorderWidth": 1,
        "borderContentGapWidth": 0,
        "verticalSpacingRows": 0,
        "spacing": {
          "beforeRows": 0,
          "afterRows": 0,
          "collapseAdjacent": true,
          "scope": "section"
        }
      },
      "style": {
        "background": "transparent",
        "rail": "transparent"
      },
      "selection": {
        "mode": "contentOnly",
        "stripAnsi": true,
        "trimRight": true,
        "includeRail": false,
        "includeGap": false,
        "includeLeadingBlankRows": false,
        "includeTrailingBlankRows": false
      }
    },
    "sections": {
      "assistantMessage": { "layout": { "alignWith": "assistantThinking" } },
      "assistantThinking": { "collapsible": true, "clickToToggle": true, "autoCollapseAfterRows": 20, "style": { "background": "transparent", "rail": { "rgb": [203, 166, 247] } } },
      "assistantReply": { "layout": { "alignWith": "assistantThinking" }, "style": { "background": "transparent", "rail": false } },
      "userMessage": { "style": { "background": { "rgb": [49, 50, 68] }, "rail": { "rgb": [137, 180, 250] } }, "selection": { "includeTimestamp": true } },
      "toolExecution": { "collapsible": true, "clickToToggle": true, "autoCollapseAfterRows": 20, "collapseByDefault": ["write"], "collapsedRenderMode": "simple", "style": { "background": "transparent", "rail": { "rgb": [166, 227, 161] } } },
      "bashExecution": {
        "collapsible": true,
        "clickToToggle": true,
        "autoCollapseAfterRows": 20,
        "collapsedRenderMode": "simple",
        "style": { "background": { "rgb": [24, 24, 37] }, "rail": { "rgb": [249, 226, 175] } },
        "layout": {
          "leftBorder": "▎",
          "borderContentGapWidth": 0,
          "verticalSpacingRows": 1,
          "spacing": { "beforeRows": 1, "afterRows": 0, "collapseAdjacent": true, "scope": "section" }
        }
      },
      "commandOutput": {
        "style": { "background": "transparent", "rail": { "rgb": [148, 226, 213] } },
        "layout": { "spacing": { "beforeRows": 1, "afterRows": 0, "collapseAdjacent": true, "scope": "group" } }
      },
      "resourceStatus": {
        "style": { "background": "transparent", "rail": { "rgb": [250, 179, 135] } },
        "layout": { "spacing": { "beforeRows": 1, "afterRows": 0, "collapseAdjacent": true, "scope": "group" } }
      },
      "selectorOutput": { "selectable": false, "style": { "background": { "rgb": [49, 50, 68] }, "rail": { "rgb": [148, 226, 213] } } },
      "custom": { "style": { "background": "transparent", "rail": false } }
    }
  },
  "footer": {
    "cwdMaxWidth": 20,
    "modelMaxWidth": 24,
    "branchMaxWidth": 16,
    "bottomGapRows": 0,
    "colors": {
      "sky": { "rgb": [137, 180, 250] },
      "mint": { "rgb": [166, 227, 161] },
      "amber": { "rgb": [249, 226, 175] },
      "lilac": { "rgb": [203, 166, 247] },
      "text": { "rgb": [205, 214, 244] },
      "muted": { "rgb": [127, 132, 156] }
    }
  }
}
